MODULE OCGMake;
(* GNU make build description for a successfully translated import graph. *)
IMPORT ORS, Files := Files07, Args, OCGBuild, OCGFiles, Target := OCGTarget;
VAR R: Files.Rider;
PROCEDURE Write(s: ARRAY OF CHAR);
  VAR i: INTEGER;
BEGIN i := 0; WHILE s[i] # 0X DO Files.Write(R, s[i]); INC(i) END END Write;
PROCEDURE Ln;
BEGIN Files.Write(R, 0AX) END Ln;
PROCEDURE Line(s: ARRAY OF CHAR);
BEGIN Write(s); Ln END Line;
PROCEDURE Tab;
BEGIN Files.Write(R, 9X) END Tab;
PROCEDURE Path(s: ARRAY OF CHAR);
  VAR i: INTEGER; ch: CHAR;
BEGIN i := 0;
  WHILE s[i] # 0X DO ch := s[i];
    IF ch = "$" THEN Write("$$")
    ELSE
      IF (ch = " ") OR (ch = 9X) OR (ch = "#") OR (ch = ":") OR (ch = "\") THEN Files.Write(R, "\") END;
      Files.Write(R, ch)
    END; INC(i)
  END
END Path;
PROCEDURE Quoted(s: ARRAY OF CHAR);
  VAR i: INTEGER; ch: CHAR;
BEGIN Files.Write(R, "'"); i := 0;
  WHILE s[i] # 0X DO ch := s[i];
    IF ch = "'" THEN Write("'\''")
    ELSIF ch = "$" THEN Write("$$")
    ELSIF ch = "#" THEN Write("\#")
    ELSE Files.Write(R, ch) END;
    INC(i)
  END;
  Files.Write(R, "'")
END Quoted;
PROCEDURE DependencyHeaders(first, p: OCGBuild.Node);
  VAR edge: OCGBuild.Edge; q: OCGBuild.Node;
BEGIN IF ~p.listed THEN p.listed := TRUE;
  Write(" "); Write(p.name); Write(".h"); edge := p.imports;
  WHILE edge # NIL DO q := first;
    WHILE (q # NIL) & (q.name # edge.name) DO q := q.next END;
    IF q # NIL THEN DependencyHeaders(first, q) END;
    edge := edge.next
  END
END END DependencyHeaders;
PROCEDURE WriteMakefile*(first: OCGBuild.Node; rootArg, flags: ARRAY OF CHAR);
  VAR p, q, root: OCGBuild.Node; name: ARRAY 80 OF CHAR;
    exe: ARRAY 256 OF CHAR; arg: ARRAY 320 OF CHAR;
    file: Files.File; i, j: INTEGER;
BEGIN IF first # NIL THEN
  root := first; WHILE root.next # NIL DO root := root.next END;
  COPY(root.name, name); i := 0; WHILE name[i] # 0X DO INC(i) END;
  name[i] := "."; name[i+1] := "m"; name[i+2] := "k"; name[i+3] := 0X;
  file := Files.New(name);
  IF file = NIL THEN ORS.Mark("cannot create generated makefile")
  ELSE Files.Set(R, file, 0);
    Line("# Generated by ORPC /b. GNU make and a GCC-compatible C compiler.");
    Line(".DEFAULT_GOAL := all"); Line(".SUFFIXES:");
    IF Target.Cortex = 0 THEN
      Line("CC ?= cc"); Line("CFLAGS ?= -O2 -std=c11"); Line("LDFLAGS ?=");
      Line("OCG_TARGET_FLAGS :=")
    ELSE
      Line("CROSS_COMPILE ?= arm-none-eabi-");
      Line("ifeq ($(origin CC),default)"); Line("CC = $(CROSS_COMPILE)gcc"); Line("endif");
      Line("CC ?= $(CROSS_COMPILE)gcc");
      Line("CFLAGS ?= -O2 -std=gnu11 -fomit-frame-pointer");
      Write("OCG_TARGET_FLAGS := -mcpu=cortex-m");
      IF Target.Cortex = 1 THEN Write("0") ELSE Files.Write(R, CHR(ORD("0")+Target.Cortex)) END;
      Write(" -mthumb -mfloat-abi=soft -ffunction-sections -fdata-sections -DOCG_CORTEX_M=");
      Files.Write(R, CHR(ORD("0")+Target.Cortex)); Ln;
      Line("LDFLAGS ?= -nostartfiles --specs=nosys.specs -Wl,--gc-sections");
      Line("LDSCRIPT ?="); Line("STARTUP_OBJS ?="); Line("ASFLAGS ?=")
    END;
    Line("CPPFLAGS ?="); Line("LDLIBS ?= -lm"); Line("EXEEXT ?="); Line("EXTRA_OBJS ?=");
    Line("OCG_RUNTIME_DIR ?= .");
    Line("OCG_RUNTIME_PATH := $(value OCG_RUNTIME_DIR)");
    Line("ifeq ($(strip $(OCG_RUNTIME_PATH)),)");
    Line("OCG_RUNTIME_PATH := ."); Line("endif");
    Line("OCG_RUNTIME_HEADER := $(OCG_RUNTIME_PATH)/ocg_runtime.h");
    Line("ocg_empty :="); Line("ocg_space := $(ocg_empty) $(ocg_empty)");
    Line("OCG_RUNTIME_DEP := $(subst $(ocg_space),\$(ocg_space),$(subst :,\:,$(OCG_RUNTIME_HEADER)))");
    Line("ocg_shell_quote = '$(subst ','\'',$(1))'");
    Line('OCG_RUNTIME_CPPFLAGS := -DOCG_RUNTIME_HEADER=$(call ocg_shell_quote,"$(OCG_RUNTIME_HEADER)")');
    Write("ORPC ?= "); Args.GetArg(0, exe); Quoted(exe); Ln;
    (* Keep the user's original short command argument and option suffix.
       Resolved ORPRED paths can exceed the command scanner's token limit. *)
    i := 0; arg[i] := '"'; INC(i); j := 0;
    WHILE rootArg[j] # 0X DO arg[i] := rootArg[j]; INC(i); INC(j) END;
    arg[i] := '"'; INC(i); arg[i] := "/"; INC(i); j := 0;
    WHILE flags[j] # 0X DO arg[i] := flags[j]; INC(i); INC(j) END; arg[i] := 0X;
    Write("ROOT_ARGUMENT := "); Quoted(arg); Ln;
    Write("TARGET := "); Write(root.name); Line("$(EXEEXT)");
    Write("MODULES :="); p := first;
    WHILE p # NIL DO Write(" "); Write(p.name); p := p.next END; Ln;
    Line("OBJECTS := $(addsuffix .o,$(MODULES))");
    Line("DEPS := $(OBJECTS:.o=.d) $(patsubst %.o,%.d,$(filter %.o,$(EXTRA_OBJS) $(STARTUP_OBJS)))");
    Write("SOURCES :="); p := first;
    WHILE p # NIL DO Write(" "); Path(p.path); p := p.next END; Ln; Ln;
    Line(".PHONY: all clean clobber"); Line("all: $(TARGET)"); Ln;
    Write("$(TARGET): $(OBJECTS) $(EXTRA_OBJS) "); Write(name);
    IF Target.Cortex # 0 THEN Write(" $(LDSCRIPT) $(STARTUP_OBJS)") END; Ln;
    IF Target.Cortex # 0 THEN
      Tab; Line('@test -n "$(LDSCRIPT)" || { echo "Set LDSCRIPT to your MCU linker script and STARTUP_OBJS to startup/vector objects"; exit 1; }');
      Tab; Line("$(CC) $(OCG_TARGET_FLAGS) $(LDFLAGS) -T$(call ocg_shell_quote,$(LDSCRIPT)) -o $@ $(OBJECTS) $(STARTUP_OBJS) $(EXTRA_OBJS) $(LDLIBS)")
    ELSE Tab; Line("$(CC) $(LDFLAGS) -o $@ $(OBJECTS) $(EXTRA_OBJS) $(LDLIBS)") END; Ln;
    Line("%.o: %.c");
    Tab; Line("$(CC) $(CPPFLAGS) $(OCG_RUNTIME_CPPFLAGS) $(OCG_TARGET_FLAGS) -I$(call ocg_shell_quote,$(OCG_RUNTIME_PATH)) $(CFLAGS) -MMD -MP -MF $(@:.o=.d) -MT $@ -c $< -o $@"); Ln;
    IF Target.Cortex # 0 THEN
      Line("%.o: %.S");
      Tab; Line("$(CC) $(CPPFLAGS) $(OCG_TARGET_FLAGS) $(ASFLAGS) -MMD -MP -MF $(@:.o=.d) -MT $@ -c $< -o $@"); Ln;
      Line("%.o: %.s");
      Tab; Line("$(CC) $(OCG_TARGET_FLAGS) $(ASFLAGS) -c $< -o $@"); Ln
    END;
    p := first;
    WHILE p # NIL DO
      q := first; WHILE q # NIL DO q.listed := FALSE; q := q.next END;
      Write(p.name); Write(".o: "); Write(p.name); Write(".c $(OCG_RUNTIME_DEP)");
      DependencyHeaders(first, p); Ln; p := p.next
    END; Ln;
    Line("# A source edit retranslates the graph; identical C/H files keep their timestamps.");
    Write(name); Line(": $(SOURCES)");
    Tab; Line("$(ORPC) Compile $(ROOT_ARGUMENT)");
    (* Refresh after a body-only edit too, otherwise unchanged makefile bytes
       would leave this rule perpetually older than its Oberon sources. *)
    Tab; Line('touch "$@"'); Ln;
    Line("# Empty source rules let removal of an obsolete import regenerate the graph.");
    p := first;
    WHILE p # NIL DO Path(p.path); Line(":"); p := p.next END; Ln;
    Line("-include $(DEPS)"); Ln;
    Line("clean:"); Tab; Line("$(RM) $(OBJECTS) $(DEPS) $(TARGET)");
    Ln; Line("clobber: clean");
    Tab; Line("$(RM) $(addsuffix .c,$(MODULES)) $(addsuffix .h,$(MODULES)) $(addsuffix .csmb,$(MODULES)) $(addsuffix .pos,$(MODULES))");
    OCGFiles.Publish(name, file)
  END
END END WriteMakefile;
END OCGMake.
